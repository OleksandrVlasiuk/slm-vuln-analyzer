# Версія промпту: V0 | V1 | V2
PROMPT_VERSION=V2

# auto (не передавати num_gpu) | cpu (num_gpu=0) | число (N шарів на GPU)
DEVICE=auto

# Параметри семплування генерації Ollama (ollama_client.py)
TEMPERATURE=0.1
TOP_P=0.9
# Максимум токенів на одну відповідь (--num-predict у bench.py перевизначає
# це для окремого запуску, напр. з --think true потрібно більше)
NUM_PREDICT=800

# Адреса локального сервера Ollama (ollama serve). Якщо недоступний —
# /api/models і /api/scan/* повертають 503 з поясненням.
OLLAMA_HOST=http://localhost:11434

# Потрібен Java >= 17 для LanguageTool (scripts/evaluate.py).
# Якщо в системі лише старіша Java, вкажіть шлях до портативного JDK 17 —
# evaluate.py сам додає JAVA_HOME\bin на початок PATH.
JAVA_HOME=D:\Tools\jdk17

# --- main.py (продукт) ---
# Набори правил Semgrep для API-сканування (ті самі, що в дослідженні, data/SOURCES.md)
SEMGREP_CONFIG=p/python p/javascript p/typescript p/owasp-top-ten

# Дозволені кореневі теки для сканування через API (через кому). Шлях поза
# ними -> 403.
SCAN_ROOTS=dataset,corpus

# HMAC-підпис токенів автентифікації (auth.py). Згенеруйте власний:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-your-own-random-hex-secret
